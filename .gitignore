# ══════════════════════════════════════════════════════════
# 依赖
# ══════════════════════════════════════════════════════════
node_modules/
.pnpm-store/

# ══════════════════════════════════════════════════════════
# 编译产物（tsc / tsdown 生成，可重建）
# ══════════════════════════════════════════════════════════
packages/*/lib/
packages/*/dist/
*.tsbuildinfo

# ══════════════════════════════════════════════════════════
# dev/ 的生成物
#
# `dev/preview/build.mjs` 把 React 内联进一个自包含 HTML（约 1 MB 一个）。
# 它是**构建输出**：`node dev/preview/build.mjs <名>` 一行就能重建。
# 提交它 = 每次改一个 CSS 就产生 1 MB 的 diff，而且 review 时满屏都是压缩后的 JS。
# ══════════════════════════════════════════════════════════
packages/dsh-client/dev/preview/index.html
packages/dsh-client/dev/preview/*/index.html

# ══════════════════════════════════════════════════════════
# 截图（verify.mjs 的输出）
#
# 两个理由：
# 1. **可重建** —— `node dev/preview/<名>/verify.mjs` 会重新拍一遍
# 2. **不稳定** —— PNG 里含当时的回调日志/时间戳，逐次跑会差几字节
#    （space-dev 2026-11-17 实测：同一个 verify 连跑两次，PNG 有 5 个 modified）
#    提交它会让「什么都没改」也出现 diff
# ══════════════════════════════════════════════════════════
packages/dsh-client/dev/shots/
packages/dsh-client/dev/preview/*/shots/
*.png
*.jpg
*.jpeg
*.gif
*.webp
# 例外：界面图标是源码，不是截图
!packages/*/icon.svg
!packages/*/locale/*.svg

# ══════════════════════════════════════════════════════════
# 运行时数据（本地状态，不入库）
# ══════════════════════════════════════════════════════════
data/
*.db
*.db-shm
*.db-wal
*.zstd

# ══════════════════════════════════════════════════════════
# 日志
# ══════════════════════════════════════════════════════════
*.log
*.log.*

# ══════════════════════════════════════════════════════════
# 临时文件
# ══════════════════════════════════════════════════════════
*.tmp
*.orig
*.rej
.commitmsg.tmp
commit-msg*.txt
_probe*.ts
_probe*.mjs
.verify/

# ══════════════════════════════════════════════════════════
# 编辑器 / 系统
# ══════════════════════════════════════════════════════════
.vs/
.vscode/
.idea/
*.vsidx
*.suo
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store
