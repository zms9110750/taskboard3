{
  "name": "@taskboard/dsh-agent-loop",
  "version": "0.1.0-3.a.1",
  "type": "module",
  "description": "任务板与 DSH 消息循环接触的那一行：#9 动机 1（无人值守）。未读上下文注入（不唤醒）+ 工作泵（followup 推进「提交/处理中」的工作卡）。整行可单独关闭 ⇒ 未读不再注入、无人值守停止推进。",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@taskboard/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
