{
  "name": "@taskboard/store",
  "version": "0.1.0-3.a.1",
  "type": "module",
  "description": "任务板存储的默认实现：node:sqlite。可整行替换。",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "cordis.patch.yml", "locale"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@taskboard/core": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
