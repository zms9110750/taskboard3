{
  "name": "@taskboard/bundle",
  "version": "0.1.0-3.a.1",
  "type": "module",
  "description": "任务板：一个 bundle。存储 / 核心实例 / Host / AI 工具 / 浏览器 UI / agent 守卫 / 权限 UI / 消息循环 各行可独立开关。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
