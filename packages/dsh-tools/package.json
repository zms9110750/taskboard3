{
  "name": "@taskboard/dsh-tools",
  "version": "0.1.0-3.a.1",
  "type": "module",
  "description": "任务板给 AI 的工具面插件行：9 个宿主无关的 taskboard_* 工具（权限 guard 与两个策略工具在 dsh-agent-guard）。关掉它，数据和界面都还在，只是 agent 用不了这些通用工具。",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@taskboard/core": "workspace:*",
    "@taskboard/protocol": "workspace:*",
    "@taskboard/tools": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@taskboard/io": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
