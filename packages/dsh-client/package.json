{
  "name": "@taskboard/dsh-client",
  "version": "0.1.0-3.a.1",
  "type": "module",
  "description": "任务板：DSH Web 客户端插件。把任务板渲染成右侧工作区的标签页。",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -b && tsdown",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@taskboard/protocol": "workspace:*",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@taskboard/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "^1.3.2",
    "tsdown": "^0.23.7",
    "@taskboard/io": "workspace:*"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
