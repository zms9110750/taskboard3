{
  "name": "@taskboard/monorepo",
  "version": "0.1.0-3.a.1",
  "private": true,
  "type": "module",
  "description": "任务板：可替换持久化与搜索的 Cordis 插件 bundle。",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b packages/protocol packages/search packages/core packages/store packages/dsh",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['protocol','search','core','store','dsh'])rmSync('packages/'+p+'/lib',{recursive:true,force:true})\"",
    "test": "node --test \"packages/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.3"
  }
}
